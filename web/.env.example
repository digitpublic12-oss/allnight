# 이 파일을 복사해 .env.local 을 만들고 실제 값을 직접 넣는다. (.env.local 은 Git에 올라가지 않음)
# 둘 다 브라우저에 공개돼도 되는 값이다. 실제 보호는 Supabase RLS(읽기 전용)가 맡는다.

# Supabase → 프로젝트 → Connect(또는 Settings → API Keys)의 Project URL
NEXT_PUBLIC_SUPABASE_URL=https://프로젝트ID.supabase.co
# 같은 화면의 Publishable key (sb_publishable_ 로 시작). sb_secret_ 키는 절대 넣지 않는다.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_여기에

# 네이버 클라우드 Maps 의 Client ID (5-6단계에서 사용)
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=
