# 이 파일을 복사해 .env.local 을 만들고 실제 값을 직접 넣는다. (.env.local 은 Git에 올라가지 않음)
# 둘 다 브라우저에 공개돼도 되는 값이다. 실제 보호는 Supabase RLS(읽기 전용)가 맡는다.

# Supabase → 프로젝트 → Connect(또는 Settings → API Keys)의 Project URL
NEXT_PUBLIC_SUPABASE_URL=https://프로젝트ID.supabase.co
# 같은 화면의 Publishable key (sb_publishable_ 로 시작). sb_secret_ 키는 절대 넣지 않는다.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_여기에

# 카카오 지도 JavaScript 키 (Kakao Developers → 내 애플리케이션 → 앱 키). 공개용이며 REST API·Admin 키는 넣지 않는다.
# 지도가 뜨려면 같은 앱에서 [카카오맵] 사용 설정 ON, [플랫폼 → Web]에 http://localhost:3000 과 배포 주소 등록이 필요하다.
NEXT_PUBLIC_KAKAO_MAP_APP_KEY=

# Cloudflare Turnstile (스팸 방지) — Site Key는 공개용
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ⚠ 서버 전용 비밀값: NEXT_PUBLIC_ 를 붙이지 않는다. 채팅·GitHub에 절대 올리지 않는다.
# Cloudflare Turnstile 의 Secret Key
TURNSTILE_SECRET_KEY=
# Supabase → Project Settings → API Keys 의 Secret key (sb_secret_ 로 시작). 서버가 제보를 접수할 때만 쓴다.
SUPABASE_SECRET_KEY=
